{
  "name": "mongodb-api-rate-limiter",
  "version": "2.0.0",
  "description": "API rate limiter using the Fixed Window Counter algorithm, Express and MongoDB (Mongoose).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npx nodemon src/server.js",
    "test": "node --test",
    "test:unit": "node --test test/rateLimiter.test.js",
    "test:integration": "node --test test/concurrency.integration.test.js",
    "concurrency": "node scripts/concurrency-check.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "license": "MIT"
}
