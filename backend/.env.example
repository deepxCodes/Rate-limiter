PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/<Your DB>
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_RETENTION_MS=86400000
# Set true ONLY behind a trusted reverse proxy (makes req.ip follow X-Forwarded-For)
TRUST_PROXY=false
# Only needed if the frontend is served from a different origin, e.g. http://127.0.0.1:5500
CORS_ORIGIN=
